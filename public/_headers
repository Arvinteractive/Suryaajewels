# Netlify / Cloudflare Pages read this file at deploy time to attach real
# HTTP response headers. It has no effect on `npm run dev` or `vite preview`
# (Vite serves public/ files verbatim, it doesn't parse this format), so it
# is safe to ship without touching local development.
#
# Deploying elsewhere (Vercel, GitHub Pages, a custom server, etc.)? Translate
# the block below into that platform's own header config — e.g. the
# `headers` array in vercel.json, or your server/CDN config.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-src https://www.google.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
